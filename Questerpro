name: Build QuestMate Complete

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:

      # ---------------------------------------------------------
      # 1. CHECK OUT REPOSITORY
      # ---------------------------------------------------------
      - name: Checkout repository
        uses: actions/checkout@v4

      # ---------------------------------------------------------
      # 2. JAVA
      # ---------------------------------------------------------
      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      # ---------------------------------------------------------
      # 3. ANDROID SDK
      # ---------------------------------------------------------
      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK packages
        run: |
          yes | sdkmanager --licenses >/dev/null || true
          sdkmanager \
            "platform-tools" \
            "platforms;android-35" \
            "build-tools;35.0.0"

      # ---------------------------------------------------------
      # 4. CREATE COMPLETE ANDROID PROJECT
      # ---------------------------------------------------------
      - name: Create QuestMate project
        shell: bash
        run: |
          set -euo pipefail

          rm -rf app
          rm -rf .quest-helper

          mkdir -p app/src/main/java/com/questmate/complete
          mkdir -p app/src/main/res/values
          mkdir -p app/src/main/assets
          mkdir -p tools

          # -----------------------------------------------------
          # SETTINGS
          # -----------------------------------------------------

          cat > settings.gradle <<'EOF'
          pluginManagement {
              repositories {
                  google()
                  mavenCentral()
                  gradlePluginPortal()
              }
          }

          dependencyResolutionManagement {
              repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
              repositories {
                  google()
                  mavenCentral()
              }
          }

          rootProject.name = "QuestMateComplete"
          include(":app")
          EOF

          # -----------------------------------------------------
          # ROOT BUILD
          # -----------------------------------------------------

          cat > build.gradle <<'EOF'
          plugins {
              id 'com.android.application' version '8.7.3' apply false
          }
          EOF

          # -----------------------------------------------------
          # GRADLE PROPERTIES
          # -----------------------------------------------------

          cat > gradle.properties <<'EOF'
          org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
          android.useAndroidX=true
          android.nonTransitiveRClass=true
          EOF

          # -----------------------------------------------------
          # APP BUILD
          # -----------------------------------------------------

          cat > app/build.gradle <<'EOF'
          plugins {
              id 'com.android.application'
          }

          android {
              namespace 'com.questmate.complete'
              compileSdk 35

              defaultConfig {
                  applicationId 'com.questmate.complete'
                  minSdk 23
                  targetSdk 35

                  versionCode 3
                  versionName "3.0"
              }

              buildTypes {
                  debug {
                      minifyEnabled false
                  }

                  release {
                      minifyEnabled false
                      shrinkResources false
                  }
              }
          }
          EOF

          # -----------------------------------------------------
          # COLORS
          # -----------------------------------------------------

          cat > app/src/main/res/values/colors.xml <<'EOF'
          <resources>

              <color name="qm_bg">#101318</color>
              <color name="qm_panel">#171B21</color>
              <color name="qm_panel2">#20252D</color>

              <color name="qm_text">#F3F5F7</color>
              <color name="qm_muted">#AEB5BF</color>

              <color name="qm_accent">#E4B34C</color>
              <color name="qm_divider">#303640</color>

          </resources>
          EOF

          # -----------------------------------------------------
          # THEME
          # -----------------------------------------------------

          cat > app/src/main/res/values/themes.xml <<'EOF'
          <resources>

              <style
                  name="AppTheme"
                  parent="android:style/Theme.Material.NoActionBar">

                  <item name="android:fontFamily">sans</item>

                  <item name="android:windowLightStatusBar">
                      false
                  </item>

                  <item name="android:statusBarColor">
                      @color/qm_bg
                  </item>

                  <item name="android:navigationBarColor">
                      @color/qm_bg
                  </item>

                  <item name="android:windowActionModeOverlay">
                      true
                  </item>

              </style>

          </resources>
          EOF

          # -----------------------------------------------------
          # MANIFEST
          # -----------------------------------------------------

          cat > app/src/main/AndroidManifest.xml <<'EOF'
          <manifest
              xmlns:android="http://schemas.android.com/apk/res/android">

              <application
                  android:theme="@style/AppTheme"
                  android:label="QuestMate Complete"
                  android:allowBackup="false"
                  android:supportsRtl="true">

                  <activity
                      android:name=".MainActivity"
                      android:screenOrientation="portrait"
                      android:exported="true">

                      <intent-filter>

                          <action
                              android:name="android.intent.action.MAIN" />

                          <category
                              android:name="android.intent.category.LAUNCHER" />

                      </intent-filter>

                  </activity>

              </application>

          </manifest>
          EOF

          # -----------------------------------------------------
          # QUEST DATABASE GENERATOR
          # -----------------------------------------------------

          cat > tools/generate_quests.py <<'PY'
          import json
          import os
          import re
          import subprocess
          from pathlib import Path

          ROOT = Path(__file__).resolve().parents[1]

          SOURCE = ROOT / ".quest-helper"

          OUTPUT = (
              ROOT
              / "app"
              / "src"
              / "main"
              / "assets"
              / "quests.json"
          )

          # -----------------------------------------------------
          # DOWNLOAD CURRENT QUEST HELPER SOURCE
          # -----------------------------------------------------

          if not SOURCE.exists():

              subprocess.run(
                  [
                      "git",
                      "clone",
                      "--depth",
                      "1",
                      "https://github.com/Zoinkwiz/quest-helper.git",
                      str(SOURCE),
                  ],
                  check=True,
              )

          JAVA_ROOT = SOURCE / "src" / "main" / "java"

          java_files = list(JAVA_ROOT.rglob("*.java"))

          # -----------------------------------------------------
          # QUEST NAME ENUM
          # -----------------------------------------------------

          quest_names = {}

          for file in java_files:

              if file.name != "QuestHelperQuest.java":
                  continue

              text = file.read_text(
                  encoding="utf-8",
                  errors="ignore",
              )

              matches = re.finditer(
                  r'^\s*([A-Z0-9_]+)\s*\(\s*"([^"]+)"',
                  text,
                  re.MULTILINE,
              )

              for match in matches:

                  key = match.group(1).strip()
                  name = match.group(2).strip()

                  if name:
                      quest_names[key] = name

          # -----------------------------------------------------
          # QUEST IMPLEMENTATIONS
          # -----------------------------------------------------

          quest_files = []

          for file in java_files:

              normalized = str(file).replace("\\", "/")

              if "/helpers/quests/" in normalized:

                  quest_files.append(file)

          # -----------------------------------------------------
          # STRING EXTRACTION
          # -----------------------------------------------------

          def java_strings(text):

              found = []

              pattern = r'"((?:\\.|[^"\\])*)"'

              for match in re.finditer(pattern, text):

                  value = match.group(1)

                  value = value.replace(
                      "\\n",
                      " ",
                  )

                  value = value.replace(
                      "\\t",
                      " ",
                  )

                  value = value.replace(
                      '\\"',
                      '"',
                  )

                  value = re.sub(
                      r"\s+",
                      " ",
                      value,
                  ).strip()

                  if value:
                      found.append(value)

              return found

          # -----------------------------------------------------
          # QUEST KEY
          # -----------------------------------------------------

          def quest_key(file):

              return (
                  file.stem
                  .upper()
                  .replace("-", "_")
              )

          # -----------------------------------------------------
          # ITEMS
          # -----------------------------------------------------

          def extract_items(text):

              items = []

              patterns = [

                  r'new\s+ItemRequirement\s*\(\s*"((?:\\.|[^"\\])*)',

                  r'ItemRequirement\s*\(\s*"((?:\\.|[^"\\])*)',

              ]

              for pattern in patterns:

                  for match in re.finditer(
                      pattern,
                      text,
                      re.MULTILINE,
                  ):

                      item = match.group(1)

                      item = item.replace(
                          "\\n",
                          " ",
                      )

                      item = re.sub(
                          r"\s+",
                          " ",
                          item,
                      ).strip()

                      if (
                          item
                          and len(item) >= 2
                          and len(item) <= 120
                          and item not in items
                      ):

                          if item.lower() not in (
                              "null",
                              "this",
                          ):

                              items.append(item)

              return items

          # -----------------------------------------------------
          # WALKTHROUGH STEPS
          # -----------------------------------------------------

          def extract_steps(text):

              steps = []

              constructors = [

                  "DetailedQuestStep",

                  "NpcStep",

                  "ObjectStep",

                  "GroundItemStep",

                  "WidgetStep",

                  "TileObjectStep",

                  "WorldPointStep",

                  "QuestStep",

              ]

              for constructor in constructors:

                  pattern = (
                      constructor
                      + r"\s*\((.*?)\)"
                  )

                  matches = re.finditer(
                      pattern,
                      text,
                      re.DOTALL,
                  )

                  for match in matches:

                      values = java_strings(
                          match.group(1)
                      )

                      for value in values:

                          value = value.strip()

                          if len(value) < 8:
                              continue

                          if len(value) > 500:
                              continue

                          lower = value.lower()

                          if lower in (
                              "null",
                              "this",
                          ):
                              continue

                          if (
                              "questhelperquest"
                              in lower
                          ):
                              continue

                          if value not in steps:

                              steps.append(value)

              # -------------------------------------------------
              # FALLBACK EXTRACTION
              # -------------------------------------------------

              if not steps:

                  candidates = java_strings(text)

                  useful_words = (
                      "talk",
                      "speak",
                      "go ",
                      "travel",
                      "return",
                      "use ",
                      "take ",
                      "bring",
                      "find",
                      "search",
                      "kill",
                      "pick",
                      "enter",
                      "climb",
                      "open",
                      "give",
                      "mine",
                      "fish",
                      "cook",
                      "bury",
                      "dig",
                      "wear",
                      "equip",
                  )

                  for value in candidates:

                      lower = value.lower()

                      if len(value) < 12:
                          continue

                      if len(value) > 400:
                          continue

                      if any(
                          word in lower
                          for word in useful_words
                      ):

                          if value not in steps:
                              steps.append(value)

              # -------------------------------------------------
              # REMOVE DUPLICATES
              # -------------------------------------------------

              output = []

              seen = set()

              for value in steps:

                  value = re.sub(
                      r"\s+",
                      " ",
                      value,
                  ).strip()

                  if value in seen:
                      continue

                  seen.add(value)
                  output.append(value)

              return output[:150]

          # -----------------------------------------------------
          # LOCATIONS
          # -----------------------------------------------------

          locations = [

              "Lumbridge",
              "Lumbridge Castle",
              "Varrock",
              "Falador",
              "Draynor Village",
              "Al Kharid",
              "Port Sarim",
              "Edgeville",
              "Barbarian Village",
              "Taverley",
              "Karamja",
              "Ardougne",
              "East Ardougne",
              "West Ardougne",
              "Yanille",
              "Canifis",
              "Mort'ton",
              "Burthorpe",
              "Rellekka",
              "Seers' Village",
              "Catherby",
              "Camelot",
              "Prifddinas",
              "Tirannwn",
              "Lletya",
              "Tree Gnome Village",
              "Gnome Stronghold",
              "Grand Tree",
              "Kourend",
              "Great Kourend",
              "Hosidius",
              "Lovakengj",
              "Shayzien",
              "Arceuus",
              "Piscarilius",
              "Shilo Village",
              "Nardah",
              "Pollnivneach",
              "Sophanem",
              "Menaphos",
              "Trollheim",
              "Wilderness",
              "Dwarven Mine",
              "Fremennik Province",
              "Lunar Isle",
              "Mos Le'Harmless",
              "Port Khazard",
              "Port Phasmatys",
              "Darkmeyer",
              "Slepe",
              "Ver Sinhaza",
              "Draynor Manor",
              "White Wolf Mountain",
              "Death Plateau",
              "Troll Stronghold",
              "Underground Pass",
              "Ape Atoll",
              "Crash Island",
              "Entrana",
              "Jatizso",
              "Neitiznot",
              "Kharidian Desert",
              "Ice Mountain",
              "Crandor",
              "Dragon Slayer Isle",
              "Legends' Guild",
              "Champions' Guild",
              "Heroes' Guild",
              "Warriors' Guild",
              "Fishing Guild",
              "Crafting Guild",
              "Mining Guild",
              "Cooking Guild",
              "Wizard's Tower",
              "Dark Wizards' Tower",
              "Observatory",
              "Digsite",
              "Digsite Camp",
              "Varrock Museum",
              "Haunted Woods",
              "Fossil Island",
              "Lighthouse",
              "Waterbirth Island",
              "Tai Bwo Wannai",
              "Brimhaven",
              "Karamja Volcano",
              "Zanaris",
              "Fairy Ring",
              "Cairn Isle",
              "Piscatoris",
              "Port Piscarilius",
              "Varlamore",
              "Cam Torum",
              "Civitas illa Fortis",

          ]

          # -----------------------------------------------------
          # BUILD QUEST RECORDS
          # -----------------------------------------------------

          quests = {}

          for file in quest_files:

              text = file.read_text(
                  encoding="utf-8",
                  errors="ignore",
              )

              key = quest_key(file)

              name = quest_names.get(key)

              if not name:

                  readable = file.stem

                  readable = re.sub(
                      r"(?<!^)(?=[A-Z])",
                      " ",
                      readable,
                  )

                  name = readable.strip()

              if not name:
                  continue

              if name.lower() == "unknown quest":
                  continue

              steps = extract_steps(text)

              if not steps:
                  continue

              items = extract_items(text)

              combined = " ".join(steps)

              found_locations = []

              for location in locations:

                  if (
                      location.lower()
                      in combined.lower()
                  ):

                      if location not in found_locations:

                          found_locations.append(
                              location
                          )

              quests[name] = {

                  "name": name,

                  "items": items,

                  "places": found_locations,

                  "start": steps[0],

                  "steps": steps,

                  "wikiUrl":
                      "https://oldschool.runescape.wiki/w/"
                      + name.replace(" ", "_"),

                  "source":
                      "RuneLite Quest Helper",

              }

          # -----------------------------------------------------
          # SORT
          # -----------------------------------------------------

          data = sorted(
              quests.values(),
              key=lambda item:
                  item["name"].lower(),
          )

          # -----------------------------------------------------
          # SAFETY CHECKS
          # -----------------------------------------------------

          if len(data) < 100:

              raise RuntimeError(
                  "Quest database generation failed. "
                  f"Only {len(data)} quests were found."
              )

          for quest in data:

              if (
                  not quest["name"]
                  or quest["name"].lower()
                  == "unknown quest"
              ):

                  raise RuntimeError(
                      "Invalid quest name detected."
                  )

              if not quest["steps"]:

                  raise RuntimeError(
                      f"No walkthrough steps for {quest['name']}"
                  )

          # -----------------------------------------------------
          # WRITE JSON
          # -----------------------------------------------------

          OUTPUT.parent.mkdir(
              parents=True,
              exist_ok=True,
          )

          OUTPUT.write_text(
              json.dumps(
                  data,
                  ensure_ascii=False,
                  indent=2,
              ),
              encoding="utf-8",
          )

          print()
          print(
              "======================================"
          )
          print(
              " QUESTMATE DATABASE GENERATED"
          )
          print(
              "======================================"
          )
          print(
              f"Quests: {len(data)}"
          )
          print(
              "With item lists:",
              sum(
                  bool(q["items"])
                  for q in data
              ),
          )
          print(
              "With locations:",
              sum(
                  bool(q["places"])
                  for q in data
              ),
          )
          print(
              "With walkthroughs:",
              sum(
                  bool(q["steps"])
                  for q in data
              ),
          )
          print(
              "======================================"
          )
          PY

      # ---------------------------------------------------------
      # 5. GENERATE QUEST DATA
      # ---------------------------------------------------------
      - name: Generate complete quest database
        run: |
          python3 tools/generate_quests.py

      # ---------------------------------------------------------
      # 6. VERIFY DATABASE
      # ---------------------------------------------------------
      - name: Verify quest database
        run: |
          python3 - <<'PY'

          import json

          path = "app/src/main/assets/quests.json"

          with open(
              path,
              "r",
              encoding="utf-8"
          ) as f:

              quests = json.load(f)

          if not quests:
              raise SystemExit(
                  "ERROR: Quest database is empty."
              )

          for quest in quests:

              name = quest.get(
                  "name",
                  ""
              ).strip()

              if not name:
                  raise SystemExit(
                      "ERROR: Empty quest name found."
                  )

              if name.lower() == "unknown quest":
                  raise SystemExit(
                      "ERROR: Unknown Quest detected."
                  )

              if not quest.get("steps"):
                  raise SystemExit(
                      f"ERROR: {name} has no walkthrough."
                  )

          print(
              f"SUCCESS: {len(quests)} real quest records verified."
          )

          PY

      # ---------------------------------------------------------
      # 7. ANDROID APP
      # ---------------------------------------------------------
      - name: Create MainActivity
        shell: bash
        run: |

          cat > app/src/main/java/com/questmate/complete/MainActivity.java <<'EOF'
          package com.questmate.complete;

          import android.app.Activity;
          import android.graphics.Color;
          import android.graphics.Typeface;
          import android.os.Bundle;
          import android.text.Editable;
          import android.text.TextWatcher;
          import android.view.Gravity;
          import android.view.View;
          import android.widget.EditText;
          import android.widget.LinearLayout;
          import android.widget.ScrollView;
          import android.widget.TextView;

          import org.json.JSONArray;
          import org.json.JSONObject;

          import java.io.BufferedReader;
          import java.io.InputStream;
          import java.io.InputStreamReader;

          import java.util.ArrayList;
          import java.util.Collections;
          import java.util.Comparator;
          import java.util.List;
          import java.util.Locale;

          public class MainActivity extends Activity {

              private static final int BG =
                      Color.rgb(16, 19, 24);

              private static final int TEXT =
                      Color.rgb(243, 245, 247);

              private static final int MUTED =
                      Color.rgb(174, 181, 191);

              private static final int ACCENT =
                      Color.rgb(228, 179, 76);

              private static final int DIVIDER =
                      Color.rgb(48, 54, 64);

              private final List<Quest> quests =
                      new ArrayList<>();

              private LinearLayout questList;

              private EditText search;

              @Override
              protected void onCreate(
                      Bundle savedInstanceState) {

                  super.onCreate(
                          savedInstanceState
                  );

                  getWindow().setStatusBarColor(
                          BG
                  );

                  getWindow().setNavigationBarColor(
                          BG
                  );

                  loadQuests();

                  showQuestList();
              }

              private int dp(float value) {

                  return (int)
                          (
                                  value *
                                  getResources()
                                          .getDisplayMetrics()
                                          .density
                                  + 0.5f
                          );
              }

              private TextView text(
                      String value,
                      float size,
                      int color) {

                  TextView view =
                          new TextView(this);

                  view.setText(value);

                  view.setTextSize(size);

                  view.setTextColor(color);

                  view.setPadding(
                          dp(16),
                          dp(10),
                          dp(16),
                          dp(10)
                  );

                  return view;
              }

              private TextView heading(
                      String value) {

                  TextView view =
                          text(
                                  value,
                                  28,
                                  TEXT
                          );

                  view.setTypeface(
                          Typeface.DEFAULT,
                          Typeface.BOLD
                  );

                  view.setPadding(
                          dp(18),
                          dp(12),
                          dp(18),
                          dp(4)
                  );

                  return view;
              }

              private TextView section(
                      String value) {

                  TextView view =
                          text(
                                  value,
                                  20,
                                  ACCENT
                          );

                  view.setTypeface(
                          Typeface.DEFAULT,
                          Typeface.BOLD
                  );

                  view.setPadding(
                          dp(16),
                          dp(20),
                          dp(16),
                          dp(8)
                  );

                  return view;
              }

              private void base(
                      LinearLayout root) {

                  root.setOrientation(
                          LinearLayout.VERTICAL
                  );

                  root.setBackgroundColor(
                          BG
                  );
              }

              // -------------------------------------------------
              // QUEST LIST
              // -------------------------------------------------

              private void showQuestList() {

                  LinearLayout root =
                          new LinearLayout(this);

                  base(root);

                  root.addView(
                          heading(
                                  "QuestMate Complete"
                          )
                  );

                  TextView count =
                          text(
                                  quests.size()
                                          + " quests • Complete walkthroughs",
                                  16,
                                  MUTED
                          );

                  count.setPadding(
                          dp(18),
                          0,
                          dp(18),
                          dp(12)
                  );

                  root.addView(count);

                  search =
                          new EditText(this);

                  search.setHint(
                          "Search quests..."
                  );

                  search.setHintTextColor(
                          MUTED
                  );

                  search.setTextColor(
                          TEXT
                  );

                  search.setTextSize(18);

                  search.setSingleLine(true);

                  search.setPadding(
                          dp(18),
                          dp(8),
                          dp(18),
                          dp(8)
                  );

                  root.addView(
                          search,
                          new LinearLayout.LayoutParams(
                                  -1,
                                  dp(58)
                          )
                  );

                  ScrollView scroll =
                          new ScrollView(this);

                  questList =
                          new LinearLayout(this);

                  questList.setOrientation(
                          LinearLayout.VERTICAL
                  );

                  scroll.addView(
                          questList
                  );

                  root.addView(
                          scroll,
                          new LinearLayout.LayoutParams(
                                  -1,
                                  0,
                                  1
                          )
                  );

                  setContentView(root);

                  renderQuestList("");

                  search.addTextChangedListener(
                          new TextWatcher() {

                              @Override
                              public void beforeTextChanged(
                                      CharSequence s,
                                      int start,
                                      int count,
                                      int after) {
                              }

                              @Override
                              public void onTextChanged(
                                      CharSequence s,
                                      int start,
                                      int before,
                                      int count) {

                                  renderQuestList(
                                          s.toString()
                                  );
                              }

                              @Override
                              public void afterTextChanged(
                                      Editable s) {
                              }
                          }
                  );
              }

              private void renderQuestList(
                      String query) {

                  questList.removeAllViews();

                  String q =
                          query
                                  .trim()
                                  .toLowerCase(
                                          Locale.ROOT
                                  );

                  int shown = 0;

                  for (final Quest quest :
                          quests) {

                      if (
                              !q.isEmpty()
                              &&
                              !quest.name
                                      .toLowerCase(
                                              Locale.ROOT
                                      )
                                      .contains(q)
                      ) {
                          continue;
                      }

                      TextView row =
                              text(
                                      quest.name,
                                      18,
                                      TEXT
                              );

                      row.setGravity(
                              Gravity.CENTER_VERTICAL
                      );

                      row.setMinHeight(
                              dp(64)
                      );

                      row.setOnClickListener(
                              v ->
                                      showQuest(
                                              quest
                                      )
                      );

                      questList.addView(
                              row,
                              new LinearLayout.LayoutParams(
                                      -1,
                                      dp(64)
                              )
                      );

                      View divider =
                              new View(this);

                      divider.setBackgroundColor(
                              DIVIDER
                      );

                      questList.addView(
                              divider,
                              new LinearLayout.LayoutParams(
                                      -1,
                                      dp(1)
                              )
                      );

                      shown++;
                  }

                  if (shown == 0) {

                      questList.addView(
                              text(
                                      "No quests match your search.",
                                      17,
                                      MUTED
                              )
                      );
                  }
              }

              // -------------------------------------------------
              // QUEST DETAIL
              // -------------------------------------------------

              private void showQuest(
                      Quest quest) {

                  LinearLayout root =
                          new LinearLayout(this);

                  base(root);

                  LinearLayout top =
                          new LinearLayout(this);

                  top.setGravity(
                          Gravity.CENTER_VERTICAL
                  );

                  TextView back =
                          text(
                                  "‹",
                                  40,
                                  TEXT
                          );

                  back.setGravity(
                          Gravity.CENTER
                  );

                  back.setPadding(
                          0,
                          0,
                          0,
                          0
                  );

                  top.addView(
                          back,
                          new LinearLayout.LayoutParams(
                                  dp(58),
                                  dp(60)
                          )
                  );

                  TextView title =
                          text(
                                  quest.name,
                                  22,
                                  TEXT
                          );

                  title.setTypeface(
