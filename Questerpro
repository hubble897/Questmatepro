                                      15,
                                      MUTED
                              )
                      );

                  } else {

                      for (
                              String item :
                              quest.items
                      ) {

                          body.addView(
                                  text(
                                          "• " + item,
                                          16,
                                          TEXT
                                  )
                          );
                      }
                  }

                  // ---------------------------------------------
                  // LOCATIONS
                  // ---------------------------------------------

                  if (
                          !quest.places.isEmpty()
                  ) {

                      body.addView(
                              section(
                                      "Places"
                              )
                      );

                      for (
                              String place :
                              quest.places
                      ) {

                          body.addView(
                                  text(
                                          "• " + place,
                                          16,
                                          TEXT
                                  )
                          );
                      }
                  }

                  // ---------------------------------------------
                  // START
                  // ---------------------------------------------

                  body.addView(
                          section(
                                  "Starting Information"
                          )
                  );

                  body.addView(
                          text(
                                  quest.start,
                                  16,
                                  TEXT
                          )
                  );

                  // ---------------------------------------------
                  // WALKTHROUGH
                  // ---------------------------------------------

                  body.addView(
                          section(
                                  "Step-by-Step Walkthrough"
                          )
                  );

                  int number = 1;

                  for (
                          String step :
                          quest.steps
                  ) {

                      TextView stepView =
                              text(
                                      number
                                              + ". "
                                              + step,
                                      16,
                                      TEXT
                              );

                      stepView.setLineSpacing(
                              0,
                              1.10f
                      );

                      stepView.setPadding(
                              dp(16),
                              dp(9),
                              dp(16),
                              dp(9)
                      );

                      body.addView(
                              stepView
                      );

                      number++;
                  }

                  // ---------------------------------------------
                  // WIKI REFERENCE
                  // ---------------------------------------------

                  body.addView(
                          section(
                                  "OSRS Wiki Reference"
                          )
                  );

                  body.addView(
                          text(
                                  quest.wikiUrl,
                                  14,
                                  MUTED
                          )
                  );

                  scroll.addView(
                          body
                  );

                  root.addView(
                          scroll,
                          new LinearLayout.LayoutParams(
                                  -1,
                                  0,
                                  1
                          )
                  );

                  setContentView(root);
              }

              // -------------------------------------------------
              // LOAD JSON
              // -------------------------------------------------

              private void loadQuests() {

                  try {

                      InputStream input =
                              getAssets().open(
                                      "quests.json"
                              );

                      BufferedReader reader =
                              new BufferedReader(
                                      new InputStreamReader(
                                              input
                                      )
                              );

                      StringBuilder json =
                              new StringBuilder();

                      String line;

                      while (
                              (
                                      line =
                                              reader.readLine()
                              ) != null
                      ) {

                          json.append(line);
                      }

                      reader.close();

                      JSONArray array =
                              new JSONArray(
                                      json.toString()
                              );

                      for (
                              int i = 0;
                              i < array.length();
                              i++
                      ) {

                          JSONObject object =
                                  array.getJSONObject(i);

                          Quest quest =
                                  new Quest();

                          quest.name =
                                  object.optString(
                                          "name",
                                          ""
                                  ).trim();

                          quest.start =
                                  object.optString(
                                          "start",
                                          ""
                                  ).trim();

                          quest.wikiUrl =
                                  object.optString(
                                          "wikiUrl",
                                          ""
                                  );

                          JSONArray items =
                                  object.optJSONArray(
                                          "items"
                                  );

                          if (
                                  items != null
                          ) {

                              for (
                                      int j = 0;
                                      j < items.length();
                                      j++
                              ) {

                                  quest.items.add(
                                          items.getString(j)
                                  );
                              }
                          }

                          JSONArray places =
                                  object.optJSONArray(
                                          "places"
                                  );

                          if (
                                  places != null
                          ) {

                              for (
                                      int j = 0;
                                      j < places.length();
                                      j++
                              ) {

                                  quest.places.add(
                                          places.getString(j)
                                  );
                              }
                          }

                          JSONArray steps =
                                  object.optJSONArray(
                                          "steps"
                                  );

                          if (
                                  steps != null
                          ) {

                              for (
                                      int j = 0;
                                      j < steps.length();
                                      j++
                              ) {

                                  quest.steps.add(
                                          steps.getString(j)
                                  );
                              }
                          }

                          if (
                                  !quest.name.isEmpty()
                                  &&
                                  !quest.steps.isEmpty()
                          ) {

                              quests.add(
                                      quest
                              );
                          }
                      }

                      Collections.sort(
                              quests,
                              new Comparator<Quest>() {

                                  @Override
                                  public int compare(
                                          Quest a,
                                          Quest b) {

                                      return a.name
                                              .toLowerCase(
                                                      Locale.ROOT
                                              )
                                              .compareTo(
                                                      b.name
                                                              .toLowerCase(
                                                                      Locale.ROOT
                                                              )
                                              );
                                  }
                              }
                      );

                  } catch (Exception error) {

                      Quest errorQuest =
                              new Quest();

                      errorQuest.name =
                              "Quest database error";

                      errorQuest.start =
                              error.toString();

                      errorQuest.steps.add(
                              "The quest database could not be loaded. "
                              + "Please rebuild the application."
                      );

                      quests.add(
                              errorQuest
                      );
                  }
              }

              // -------------------------------------------------
              // QUEST MODEL
              // -------------------------------------------------

              private static class Quest {

                  String name = "";

                  String start = "";

                  String wikiUrl = "";

                  List<String> items =
                          new ArrayList<>();

                  List<String> places =
                          new ArrayList<>();

                  List<String> steps =
                          new ArrayList<>();
              }
          }
