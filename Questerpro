      # ---------------------------------------------------------
      # 8. GENERATE DATABASE
      # ---------------------------------------------------------
      - name: Generate quest database
        run: |
          python3 tools/generate_quests.py

      # ---------------------------------------------------------
      # 9. FINAL DATABASE CHECK
      # ---------------------------------------------------------
      - name: Final database validation
        run: |
          python3 - <<'PY'

          import json
          import sys

          path = "app/src/main/assets/quests.json"

          with open(
              path,
              "r",
              encoding="utf-8"
          ) as f:

              quests = json.load(f)

          print(
              "Quest records:",
              len(quests)
          )

          if len(quests) < 100:

              print(
                  "ERROR: Too few quest records."
              )

              sys.exit(1)

          for quest in quests:

              name = quest["name"].strip()

              if name.lower() == "unknown quest":

                  print(
                      "ERROR: Unknown Quest found:",
                      name
                  )

                  sys.exit(1)

              if not quest["steps"]:

                  print(
                      "ERROR: Quest has no steps:",
                      name
                  )

                  sys.exit(1)

          print(
              "DATABASE VALIDATION PASSED"
          )

          PY

